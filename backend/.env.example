PROJECT_NAME="ZeroGate ZTNA Simulator API"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api"

# Default SQLite database for zero-config local development
DATABASE_URL="sqlite:///./zerogate.db"

# PostgreSQL connection string example for Docker or Production:
# DATABASE_URL="postgresql://zerogate:zerogate_secret@localhost:5432/zerogate_db"

# CORS configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
